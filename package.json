{
  "name": "sr-loan",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@repo/*",
    "dev:packages": "turbo run dev --filter=@repo/*",
    "build:apps": "turbo run build --filter=!@repo/*",
    "build:packages": "turbo run build --filter=@repo/*",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:staged": "turbo run lint:staged",
    "ui": "turbo devtools --port 8520",
    "install:lockfile": "pnpm install --lockfile-only",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.11.5",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  },
  "packageManager": "pnpm@10.27.0"
}
