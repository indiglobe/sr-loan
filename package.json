{
  "name": "sr-loan",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "preinstall": "corepack prepare pnpm@10.27.0 --activate",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@repo/*",
    "dev:packages": "turbo run dev --filter=@repo/*",
    "build:apps": "turbo run build --filter=!@repo/*",
    "build:packages": "turbo run build --filter=@repo/*",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:staged": "turbo run lint:staged",
    "ui": "turbo devtools --port 8520",
    "build:dev:apps": "turbo run build --filter=@repo/* && turbo run dev --filter=!@repo/*",
    "build:dev:apps:web": "turbo run build --filter=@repo/* && turbo run dev --filter=web",
    "build:dev:apps:dashboard": "turbo run build --filter=@repo/* && turbo run dev --filter=dashboard",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.11.6",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.27.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18"
  }
}
